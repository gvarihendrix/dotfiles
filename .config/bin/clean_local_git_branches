#! /usr/bin/env bash

DATE_RANGE="${1-'2 weeks ago'}"
for k in $(git branch | sed '/\*/d'); do
	if [ -z "$(git log -1 --before='1 week ago' -s "$k")" ]; then
		echo "Deleting branch $k"
		# git branch -D "$k"
	else
		age=$(git log -1 --pretty=format:%cr "$k")
		echo "Latest commit on branch $k is $age"
	fi
done
